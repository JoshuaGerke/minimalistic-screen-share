# Maintainer: Joshua Gerke <kontakt@joshua-gerke.de>
pkgname=minimalistic-screen-share-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Leichtes Screensharing: Bildschirm oder Fenster plus Systemton, Discord-Optik, im Tray"
arch=('x86_64' 'aarch64')
url="https://github.com/JoshuaGerke/minimalistic-screen-share"
license=('MIT')
depends=()
optdepends=(
	'wf-recorder: flüssiges H.264-Video über die Grafikkarte'
	'grim: Aufnahme unter Wayland'
	'slurp: Bereich zum Aufnehmen mit der Maus auswählen'
	'libpulse: Systemton mitschicken (parec)'
	'waybar: irgendein Tray-Host für das Symbol'
)
makedepends=('go' 'git')
provides=('minimalistic-screen-share')
conflicts=('minimalistic-screen-share')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
	cd "$pkgname"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "$pkgname"
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-s -w" -o mss-share ./cmd/share
	go build -trimpath -ldflags "-s -w" -o mss-relay ./cmd/relay
	go build -trimpath -ldflags "-s -w" -o mss-viewer ./cmd/viewer
}

package() {
	cd "$pkgname"
	install -Dm755 mss-share "$pkgdir/usr/bin/mss-share"
	install -Dm755 mss-relay "$pkgdir/usr/bin/mss-relay"
	install -Dm755 mss-viewer "$pkgdir/usr/bin/mss-viewer"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 packaging/minimalistic-screen-share.desktop \
		"$pkgdir/usr/share/applications/minimalistic-screen-share.desktop"
	install -Dm644 packaging/mss-relay.service \
		"$pkgdir/usr/lib/systemd/user/mss-relay.service"
}
